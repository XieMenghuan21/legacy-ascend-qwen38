+namespace setrows_910_detail {
+constexpr int32_t key_marker = 0x53524b31;
+constexpr int32_t value_marker = 0x53525631;
+constexpr uint32_t blocks = 32;
+
+static bool shape(const ggml_tensor * tensor, ggml_type type, int64_t d0, int64_t d1) {
+    return tensor != nullptr && tensor->type == type && tensor->ne[0] == d0 && tensor->ne[1] == d1 &&
+           tensor->ne[2] == 1 && tensor->ne[3] == 1 && ggml_is_contiguous(tensor);
+}
+
+static bool can_read_index_block(const ggml_tensor * index) {
+    if (index->buffer == nullptr || index->data == nullptr) return false;
+    const uintptr_t pointer = reinterpret_cast<uintptr_t>(index->data);
+    const uintptr_t base = reinterpret_cast<uintptr_t>(ggml_backend_buffer_get_base(index->buffer));
+    const size_t bytes = ggml_backend_buffer_get_size(index->buffer);
+    return pointer % 32 == 0 && pointer >= base && pointer - base <= bytes && bytes - (pointer - base) >= 32;
+}
+
+static const std::string & directory() {
+    static const std::string path = []() {
+        const char * value = std::getenv("GGML_CANN_SETROWS_910_DIR");
+        return value == nullptr ? std::string() : std::string(value);
+    }();
+    return path;
+}
+
+struct binary {
+    std::vector<char> image;
+    std::string stub;
+    std::string entry;
+    void * handle = nullptr;
+    std::atomic_flag logged = ATOMIC_FLAG_INIT;
+
+    explicit binary(bool value) : stub(value ? "setrows_v_910_t1_ggml" : "setrows_k_910_t1_ggml"),
+        entry(value ? "setrows_v_910_t1__kernel0" : "setrows_k_910_t1__kernel0") {
+        const std::string path = directory() + (value ? "/setrows_v_910_t1.o" : "/setrows_k_910_t1.o");
+        std::ifstream input(path, std::ios::binary | std::ios::ate);
+        if (!input) GGML_ABORT("Cannot open SET_ROWS 910 kernel: %s", path.c_str());
+        const std::streamoff size = input.tellg();
+        if (size <= 0 || size > 64 * 1024 * 1024) GGML_ABORT("Invalid SET_ROWS 910 ELF size");
+        image.resize(static_cast<size_t>(size));
+        input.seekg(0);
+        if (!input.read(image.data(), static_cast<std::streamsize>(image.size()))) GGML_ABORT("Incomplete SET_ROWS 910 ELF");
+        rtDevBinary_t descriptor{RT_DEV_BINARY_MAGIC_ELF, 0, image.data(), image.size()};
+        ACL_CHECK(rtDevBinaryRegister(&descriptor, &handle));
+        ACL_CHECK(rtFunctionRegister(handle, stub.c_str(), entry.c_str(), entry.c_str(), 0));
+    }
+};
+
+static binary & kernel(bool value) {
+    if (value) {
+        static binary * const instance = new binary(true);
+        return *instance;
+    }
+    static binary * const instance = new binary(false);
+    return *instance;
+}
