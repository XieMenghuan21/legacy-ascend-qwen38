@@ -0,0 +1,124 @@
+#include "ssm_910.h"
+
+#include <runtime/rt.h>
+
+#include <array>
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace {
+constexpr int64_t KERNEL_WIDTH = 4;
+constexpr int64_t CHANNELS = 10240;
+constexpr uint32_t BLOCKS = 32;
+constexpr std::streamoff MAX_ELF_BYTES = 64 * 1024 * 1024;
+
+bool shape(const ggml_tensor * tensor, int64_t d0, int64_t d1) {
+    return tensor != nullptr && tensor->type == GGML_TYPE_F32 &&
+           tensor->ne[0] == d0 && tensor->ne[1] == d1 &&
+           tensor->ne[2] == 1 && tensor->ne[3] == 1 && ggml_is_contiguous(tensor);
+}
+
+struct ssm_spec {
+    const std::string path;
+    const std::string stub = "ssm_conv_910_ggml_t1";
+    const std::string entry = "ssm_conv_910_t1__kernel0";
+    const bool available;
+
+    ssm_spec() : path(configured_path()), available(readable_elf(path)) {}
+
+private:
+    static std::string configured_path() {
+        const char * value = std::getenv("GGML_CANN_SSM_910_BINARY");
+        return value != nullptr ? value : "";
+    }
+
+    static bool readable_elf(const std::string & path) {
+        if (path.empty()) {
+            return false;
+        }
+        std::ifstream input(path, std::ios::binary | std::ios::ate);
+        if (!input) {
+            return false;
+        }
+        const std::streamoff size = input.tellg();
+        return size > 0 && size <= MAX_ELF_BYTES;
+    }
+};
+
+const ssm_spec & specification() {
+    // The immutable configuration and registration strings outlive ACL teardown.
+    static const ssm_spec * const spec = new ssm_spec();
+    return *spec;
+}
+
+struct ssm_binary {
+    std::vector<char> image;
+    void * handle = nullptr;
+    const ssm_spec & spec;
+    std::atomic_flag logged = ATOMIC_FLAG_INIT;
+
+    ssm_binary() : spec(specification()) {
+        GGML_ASSERT(spec.available);
+        std::ifstream input(spec.path, std::ios::binary | std::ios::ate);
+        if (!input) {
+            GGML_ABORT("Cannot open SSM 910 kernel: %s", spec.path.c_str());
+        }
+        const std::streamoff size = input.tellg();
+        if (size <= 0 || size > MAX_ELF_BYTES) {
+            GGML_ABORT("Invalid SSM 910 ELF size: %lld", static_cast<long long>(size));
+        }
+        image.resize(static_cast<size_t>(size));
+        input.seekg(0);
+        if (!input.read(image.data(), static_cast<std::streamsize>(image.size()))) {
+            GGML_ABORT("Cannot read complete SSM 910 kernel: %s", spec.path.c_str());
+        }
+        rtDevBinary_t binary{RT_DEV_BINARY_MAGIC_ELF, 0, image.data(), image.size()};
+        ACL_CHECK(rtDevBinaryRegister(&binary, &handle));
+        ACL_CHECK(rtFunctionRegister(handle, spec.stub.c_str(), spec.entry.c_str(), spec.entry.c_str(), 0));
+    }
+
+    ssm_binary(const ssm_binary &) = delete;
+    ssm_binary & operator=(const ssm_binary &) = delete;
+};
+
+ssm_binary & kernel() {
+    // Thread-safe initialization; ELF storage stays alive until process exit.
+    static ssm_binary * const instance = new ssm_binary();
+    return *instance;
+}
+}  // namespace
+
+bool ggml_cann_try_ssm_910(ggml_backend_cann_context & ctx, ggml_tensor * dst) {
+    if (dst == nullptr || dst->op != GGML_OP_SSM_CONV ||
+        !shape(dst, CHANNELS, 1) || !shape(dst->src[0], KERNEL_WIDTH, CHANNELS) ||
+        !shape(dst->src[1], KERNEL_WIDTH, CHANNELS)) {
+        return false;
+    }
+#ifdef USE_ACL_GRAPH
+    if (ctx.acl_graph_mode) {
+        return false;
+    }
+#endif
+    if (!specification().available) {
+        return false;
+    }
+    ggml_cann_set_device(ctx.device);
+    const char * soc = aclrtGetSocName();
+    if (soc == nullptr || std::strcmp(soc, "Ascend910B") != 0) {
+        return false;
+    }
+
+    ssm_binary & binary = kernel();
+    std::array<void *, 3> arguments{dst->src[0]->data, dst->src[1]->data, dst->data};
+    ACL_CHECK(rtKernelLaunch(binary.spec.stub.c_str(), BLOCKS, arguments.data(),
+                            sizeof(arguments), nullptr, ctx.stream()));
+    if (!binary.logged.test_and_set(std::memory_order_relaxed)) {
+        GGML_LOG_INFO("ggml_cann_try_ssm_910: custom SSM launch queued channels=%lld device=%d blocks=%u\n",
+                      static_cast<long long>(CHANNELS), ctx.device, BLOCKS);
+    }
+    return true;
+}
