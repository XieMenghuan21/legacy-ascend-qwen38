+#include "rope_910_native.inc"
+
+// Included from aclnn_ops.cpp after aclnn_rope_cache_init. All arithmetic stays
+// on the NPU; the existing cache generator supplies exact IMRoPE sector rules.
+static void ggml_cann_rope_910_composite(ggml_backend_cann_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_cann_supports_rope_910(dst));
+    if (ggml_cann_try_rope_910_native(ctx, dst)) return;
+    ggml_tensor * src = dst->src[0];
+    const int64_t rotated = reinterpret_cast<const int32_t *>(dst->op_params)[1];
+    const int64_t half = rotated / 2;
+    int64_t half_ne[GGML_MAX_DIMS] = { half, dst->ne[1], dst->ne[2], dst->ne[3] };
+    int64_t trig_ne[GGML_MAX_DIMS] = { half, 1, dst->ne[2], 1 };
+    size_t trig_nb[GGML_MAX_DIMS] = {
+        sizeof(float), static_cast<size_t>(rotated) * sizeof(float),
+        static_cast<size_t>(rotated) * sizeof(float),
+        static_cast<size_t>(rotated * dst->ne[2]) * sizeof(float),
+    };
+    size_t tmp_nb[GGML_MAX_DIMS];
+    tmp_nb[0] = sizeof(float);
+    for (int dimension = 1; dimension < GGML_MAX_DIMS; ++dimension) {
+        tmp_nb[dimension] = tmp_nb[dimension - 1] * half_ne[dimension - 1];
+    }
+    const size_t half_bytes = static_cast<size_t>(half * dst->ne[1] * dst->ne[2] * dst->ne[3]) * sizeof(float);
+    ggml_cann_pool_alloc products(ctx.pool(), 4 * half_bytes);
+    auto * const product_base = static_cast<char *>(products.get());
+    acl_tensor_ptr a = ggml_cann_create_tensor(product_base, ACL_FLOAT, sizeof(float), half_ne, tmp_nb, GGML_MAX_DIMS);
+    acl_tensor_ptr b = ggml_cann_create_tensor(product_base + half_bytes, ACL_FLOAT, sizeof(float), half_ne, tmp_nb, GGML_MAX_DIMS);
+    acl_tensor_ptr c = ggml_cann_create_tensor(product_base + 2 * half_bytes, ACL_FLOAT, sizeof(float), half_ne, tmp_nb, GGML_MAX_DIMS);
+    acl_tensor_ptr d = ggml_cann_create_tensor(product_base + 3 * half_bytes, ACL_FLOAT, sizeof(float), half_ne, tmp_nb, GGML_MAX_DIMS);
+    acl_tensor_ptr lo = ggml_cann_create_tensor(src->data, ACL_FLOAT, sizeof(float), half_ne, src->nb, GGML_MAX_DIMS);
+    acl_tensor_ptr hi = ggml_cann_create_tensor(static_cast<char *>(src->data) + half * sizeof(float), ACL_FLOAT,
+                                               sizeof(float), half_ne, src->nb, GGML_MAX_DIMS);
+    acl_tensor_ptr out_lo = ggml_cann_create_tensor(dst->data, ACL_FLOAT, sizeof(float), half_ne, dst->nb, GGML_MAX_DIMS);
+    acl_tensor_ptr out_hi = ggml_cann_create_tensor(static_cast<char *>(dst->data) + half * sizeof(float), ACL_FLOAT,
+                                                   sizeof(float), half_ne, dst->nb, GGML_MAX_DIMS);
+    acl_tensor_ptr cosine = ggml_cann_create_tensor(ctx.rope_cache.cos_cache, ACL_FLOAT, sizeof(float), trig_ne, trig_nb, GGML_MAX_DIMS);
+    acl_tensor_ptr sine = ggml_cann_create_tensor(ctx.rope_cache.sin_cache, ACL_FLOAT, sizeof(float), trig_ne, trig_nb, GGML_MAX_DIMS);
+
+    // Read all four products before writing either half, also safe in-place.
+    aclnn_mul(ctx, lo.get(), cosine.get(), a.get());
+    aclnn_mul(ctx, hi.get(), sine.get(), b.get());
+    aclnn_mul(ctx, lo.get(), sine.get(), c.get());
+    aclnn_mul(ctx, hi.get(), cosine.get(), d.get());
+    aclnn_sub(ctx, a.get(), b.get(), out_lo.get());
+    aclnn_add(ctx, c.get(), d.get(), out_hi.get());
+
+    if (rotated < dst->ne[0] && src->data != dst->data) {
+        int64_t tail_ne[GGML_MAX_DIMS] = { dst->ne[0] - rotated, dst->ne[1], dst->ne[2], dst->ne[3] };
+        acl_tensor_ptr in_tail = ggml_cann_create_tensor(static_cast<char *>(src->data) + rotated * sizeof(float),
+            ACL_FLOAT, sizeof(float), tail_ne, src->nb, GGML_MAX_DIMS);
+        acl_tensor_ptr out_tail = ggml_cann_create_tensor(static_cast<char *>(dst->data) + rotated * sizeof(float),
+            ACL_FLOAT, sizeof(float), tail_ne, dst->nb, GGML_MAX_DIMS);
+        cann_copy(ctx, in_tail.get(), out_tail.get());
+    }
+}
