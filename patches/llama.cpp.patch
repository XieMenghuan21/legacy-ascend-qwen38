+#pragma once
+
+#include "ggml.h"
+
+#include <cstdlib>
+#include <cstring>
+
+// This opt-in path intentionally covers Qwen3.5/3.8's F32 IMRoPE only.
+// Keeping a narrow predicate makes other RoPE modes retain their CPU fallback.
+static inline bool ggml_cann_supports_rope_910(const ggml_tensor * op) {
+    static const bool enabled = []() {
+        const char * value = std::getenv("GGML_CANN_ROPE_910_COMPOSITE");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    if (!enabled || op == nullptr || op->op != GGML_OP_ROPE || op->src[0] == nullptr ||
+        op->src[1] == nullptr || op->src[2] != nullptr || op->type != GGML_TYPE_F32 ||
+        op->src[0]->type != GGML_TYPE_F32 || op->src[1]->type != GGML_TYPE_I32) {
+        return false;
+    }
+    const int32_t * p = reinterpret_cast<const int32_t *>(op->op_params);
+    const int dimensions = p[1];
+    const int sections = p[11] + p[12] + p[13] + p[14];
+    return p[2] == GGML_ROPE_TYPE_IMROPE && p[15] == 0 && dimensions > 0 &&
+           dimensions % 2 == 0 && dimensions <= op->ne[0] && op->ne[0] <= 896 &&
+           sections > 0 && sections <= dimensions && p[11] >= 0 && p[12] >= 0 &&
+           p[13] >= 0 && p[14] >= 0 && op->src[0]->nb[0] == sizeof(float) &&
+           op->nb[0] == sizeof(float) && op->src[1]->ne[0] >= 4 * op->ne[2];
+}
