+namespace {
+constexpr float EPSILON = 1.0e-6f;
+constexpr float L2_EPSILON = EPSILON / 128.0f;
+constexpr std::streamoff MAX_ELF_BYTES = 64 * 1024 * 1024;
+
+struct rms_shape {
+    int64_t width;
+    int64_t rows;
+    int64_t stride;
+    uint32_t blocks;
+    float epsilon;
+};
+
+constexpr std::array<rms_shape, 5> SHAPES{{
+    {5120, 1, 5120, 1, EPSILON}, {128, 48, 128, 32, EPSILON},
+    {256, 24, 512, 24, EPSILON}, {256, 4, 256, 4, EPSILON},
+    {128, 16, 128, 16, L2_EPSILON},
+}};
+
+struct rms_binary {
+    std::vector<char> image;
+    std::string stub;
+    std::string entry;
+    void * handle = nullptr;
+    std::atomic_flag logged = ATOMIC_FLAG_INIT;
+    const rms_shape spec;
+
+    rms_binary(const rms_shape & shape, const std::string & directory) : spec(shape) {
+        const std::string name = "rms_910_w" + std::to_string(spec.width) +
+                                 "_r" + std::to_string(spec.rows) + "_s" + std::to_string(spec.stride) +
+                                 (spec.epsilon == L2_EPSILON ? "_l2" : "");
+        const std::string path = directory + "/" + name + ".o";
+        std::ifstream input(path, std::ios::binary | std::ios::ate);
+        // Missing optional kernels deliberately preserve the official implementation.
+        if (!input) {
+            return;
+        }
+        const std::streamoff size = input.tellg();
+        if (size <= 0 || size > MAX_ELF_BYTES) {
+            GGML_ABORT("Invalid RMS 910 ELF size: %s", path.c_str());
+        }
+        image.resize(static_cast<size_t>(size));
+        input.seekg(0);
+        if (!input.read(image.data(), static_cast<std::streamsize>(image.size()))) {
+            GGML_ABORT("Cannot read complete RMS 910 kernel: %s", path.c_str());
+        }
+        stub = name + "_ggml";
+        entry = name + "__kernel0";
+        rtDevBinary_t binary{RT_DEV_BINARY_MAGIC_ELF, 0, image.data(), image.size()};
+        ACL_CHECK(rtDevBinaryRegister(&binary, &handle));
+        ACL_CHECK(rtFunctionRegister(handle, stub.c_str(), entry.c_str(), entry.c_str(), 0));
+    }
+};
+
+rms_binary * binary(size_t index) {
+    // Registration strings and ELF images must outlive ACL context teardown.
+    struct registry {
+        const std::string directory;
+        std::array<std::once_flag, SHAPES.size()> initialized;
+        std::array<rms_binary *, SHAPES.size()> binaries{};
+        registry() : directory(path()) {}
+        static std::string path() {
+            const char * value = std::getenv("GGML_CANN_RMS_910_DIR");
+            return value == nullptr ? "" : value;
+        }
+    };
+    static registry * const instance = new registry();
+    if (instance->directory.empty()) {
+        return nullptr;
+    }
+    std::call_once(instance->initialized[index], [&] {
+        instance->binaries[index] = new rms_binary(SHAPES[index], instance->directory);
+    });
+    return instance->binaries[index];
+}
+}  // namespace
+
+bool ggml_cann_try_rms_910(ggml_backend_cann_context & ctx, ggml_tensor * dst) {
+    if (dst == nullptr || dst->op != GGML_OP_RMS_NORM || dst->type != GGML_TYPE_F32 ||
+        dst->src[0] == nullptr || dst->src[0]->type != GGML_TYPE_F32 || !ggml_is_contiguous(dst)) {
+        return false;
+    }
+#ifdef USE_ACL_GRAPH
+    if (ctx.acl_graph_mode) {
+        return false;
+    }
+#endif
+    const ggml_tensor * src = dst->src[0];
+    float epsilon = 0.0f;
+    std::memcpy(&epsilon, dst->op_params, sizeof(epsilon));
+    if (src->nb[0] != sizeof(float) || src->ne[2] != 1 ||
+        src->ne[3] != 1 || !ggml_are_same_shape(src, dst)) {
+        return false;
+    }
+    size_t index = 0;
+    for (; index < SHAPES.size(); ++index) {
+        const rms_shape & spec = SHAPES[index];
+        if (epsilon == spec.epsilon && src->ne[0] == spec.width && src->ne[1] == spec.rows &&
+            src->nb[1] == static_cast<size_t>(spec.stride) * sizeof(float)) {
+            break;
+        }
+    }
+    if (index == SHAPES.size()) {
+        return false;
+    }
+    ggml_cann_set_device(ctx.device);
+    const char * soc = aclrtGetSocName();
+    if (soc == nullptr || std::strcmp(soc, "Ascend910B") != 0) {
+        return false;
+    }
+    rms_binary * const kernel = binary(index);
+    if (kernel == nullptr || kernel->handle == nullptr) {
+        return false;
+    }
+    std::array<void *, 2> arguments{src->data, dst->data};
+    ACL_CHECK(rtKernelLaunch(kernel->stub.c_str(), kernel->spec.blocks, arguments.data(),
+                            sizeof(arguments), nullptr, ctx.stream()));
+    if (!kernel->logged.test_and_set(std::memory_order_relaxed)) {
+        GGML_LOG_INFO("ggml_cann_try_rms_910: custom RMS launch queued width=%lld rows=%lld stride=%lld device=%d\n",
+                      static_cast<long long>(kernel->spec.width), static_cast<long long>(kernel->spec.rows),
+                      static_cast<long long>(kernel->spec.stride), ctx.device);
+    }
+    return true;
+}
