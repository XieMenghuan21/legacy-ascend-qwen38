+static binary & kernel(int64_t heads) {
+    if (heads == 4) {
+        static binary * const instance = new binary(4);
+        return *instance;
+    }
+    static binary * const instance = new binary(24);
+    return *instance;
+}
+}
+
+// Called after the existing cache generator, before composite arithmetic.
+static bool ggml_cann_try_rope_910_native(ggml_backend_cann_context & ctx, ggml_tensor * dst) {
+    using namespace rope_910_native_detail;
+    if (directory().empty() || !ggml_cann_supports_rope_910(dst)) return false;
+#ifdef USE_ACL_GRAPH
+    if (ctx.acl_graph_mode) return false;
+#endif
+    const ggml_tensor * src = dst->src[0];
+    if (dst->ne[0] != 256 || (dst->ne[1] != 4 && dst->ne[1] != 24) ||
+        dst->ne[2] != 1 || dst->ne[3] != 1 ||
+        reinterpret_cast<const int32_t *>(dst->op_params)[1] != 64 ||
+        !ggml_is_contiguous(src) || !ggml_is_contiguous(dst) ||
+        ctx.rope_cache.sin_cache == nullptr || ctx.rope_cache.cos_cache == nullptr ||
+        reinterpret_cast<uintptr_t>(src->data) % 32 != 0 || reinterpret_cast<uintptr_t>(dst->data) % 32 != 0) {
+        return false;
+    }
+    ggml_cann_set_device(ctx.device);
+    const char * soc = aclrtGetSocName();
+    if (soc == nullptr || std::strcmp(soc, "Ascend910B") != 0) return false;
+    binary & selected = kernel(dst->ne[1]);
+    std::array<void *, 4> args{src->data, ctx.rope_cache.sin_cache, ctx.rope_cache.cos_cache, dst->data};
+    ACL_CHECK(rtKernelLaunch(selected.stub.c_str(), selected.blocks, args.data(), sizeof(args), nullptr, ctx.stream()));
+    if (!selected.logged.test_and_set(std::memory_order_relaxed)) {
+        GGML_LOG_INFO("ggml_cann_try_rope_910_native: F32 H=%lld D=256 rot=64 decode queued on device %d\n",
+                      static_cast<long long>(dst->ne[1]), ctx.device);
+    }
+    return true;
+}
