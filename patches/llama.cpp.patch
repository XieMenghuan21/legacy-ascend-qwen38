+++ b/ggml/src/ggml-cann/gdn_910.cpp
@@ -0,0 +1,292 @@
+#include "gdn_910.h"
+
+#include <runtime/rt.h>
+
+#include <array>
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace {
+constexpr int64_t WIDTH = 128;
+constexpr size_t ROW_BYTES = WIDTH * sizeof(float);
+constexpr std::streamoff MAX_ELF_BYTES = 64 * 1024 * 1024;
+
+enum class gdn_mode {
+    packed32,
+    packed48,
+    native48_q16,
+    native48_q48,
+    unavailable,
+};
+
+std::string environment_path(const char * variable, const char * filename = nullptr) {
+    const char * value = std::getenv(variable);
+    if (value == nullptr || value[0] == '\0') {
+        return {};
+    }
+    std::string path(value);
+    if (filename != nullptr) {
+        if (path.back() != '/') {
+            path += '/';
+        }
+        path += filename;
+    }
+    return path;
+}
+
+bool readable_elf(const std::string & path) {
+    if (path.empty()) {
+        return false;
+    }
+    std::ifstream input(path, std::ios::binary | std::ios::ate);
+    if (!input) {
+        return false;
+    }
+    const std::streamoff size = input.tellg();
+    return size > 0 && size <= MAX_ELF_BYTES;
+}
+
+struct gdn_spec {
+    const std::string path;
+    const std::string stub;
+    const std::string entry;
+    const bool available;
+
+    gdn_spec(std::string path_value, const char * stub_value, const char * entry_value)
+        : path(std::move(path_value)), stub(stub_value), entry(entry_value), available(readable_elf(path)) {}
+};
+
+const gdn_spec & specification(gdn_mode mode) {
+    // Environment configuration is immutable for a process. Cache file checks so
+    // support queries do not perform filesystem I/O for every decoded token.
+    switch (mode) {
+        case gdn_mode::packed32: {
+            static const gdn_spec * const spec = new gdn_spec(environment_path("GGML_CANN_GDN_910_BINARY"),
+                                       "gdn_decode_910_ggml_h32", "gdn_decode_910__kernel0");
+            return *spec;
+        }
+        case gdn_mode::packed48: {
+            static const gdn_spec * const spec = new gdn_spec(environment_path("GGML_CANN_GDN_910_BINARY_48"),
+                                       "gdn_decode_910_ggml_h48", "gdn_decode_910_h48__kernel0");
+            return *spec;
+        }
+        case gdn_mode::native48_q16: {
+            static const gdn_spec * const spec = new gdn_spec(environment_path("GGML_CANN_GDN_NATIVE_DIR", "gdn_native_h48_q16.o"),
+                                       "gdn_native_910_ggml_h48_q16", "gdn_native_h48_q16__kernel0");
+            return *spec;
+        }
+        case gdn_mode::native48_q48: {
+            static const gdn_spec * const spec = new gdn_spec(environment_path("GGML_CANN_GDN_NATIVE_DIR", "gdn_native_h48_q48.o"),
+                                       "gdn_native_910_ggml_h48_q48", "gdn_native_h48_q48__kernel0");
+            return *spec;
+        }
+        case gdn_mode::unavailable:
+            GGML_ABORT("No compatible GDN 910 kernel");
+    }
+    GGML_ABORT("Invalid GDN 910 kernel mode");
+}
+
+bool shape(const ggml_tensor * tensor, int64_t d0, int64_t d1, int64_t d2, int64_t d3) {
+    return tensor->ne[0] == d0 && tensor->ne[1] == d1 && tensor->ne[2] == d2 && tensor->ne[3] == d3;
+}
+
+gdn_mode select_mode(const ggml_tensor * op) {
+    const ggml_tensor * q = op->src[0];
+    const ggml_tensor * k = op->src[1];
+    const ggml_tensor * v = op->src[2];
+    // The common support checks already enforce FP32 rows, compact gates, T=B=1.
+    if (v->ne[1] == 48 && q->ne[1] == k->ne[1] &&
+        q->nb[1] == ROW_BYTES && k->nb[1] == ROW_BYTES && v->nb[1] == ROW_BYTES) {
+        if (q->ne[1] == 16 && specification(gdn_mode::native48_q16).available) {
+            return gdn_mode::native48_q16;
+        }
+        if (q->ne[1] == 48 && specification(gdn_mode::native48_q48).available) {
+            return gdn_mode::native48_q48;
+        }
+    }
+    const gdn_mode packed = v->ne[1] == 48 ? gdn_mode::packed48 : gdn_mode::packed32;
+    return specification(packed).available ? packed : gdn_mode::unavailable;
+}
+
+bool is_native(gdn_mode mode) {
+    return mode == gdn_mode::native48_q16 || mode == gdn_mode::native48_q48;
+}
+
+// Keep ELF bytes, registration handle and host-stub address stable for process
+// lifetime. Eager execution only; registration precedes the first launch.
+struct gdn_binary {
+    std::vector<char> image;
+    void * handle = nullptr;
+    const gdn_spec & spec;
+    std::atomic_flag logged = ATOMIC_FLAG_INIT;
+
+    explicit gdn_binary(gdn_mode mode) : spec(specification(mode)) {
+        GGML_ASSERT(spec.available);
+        std::ifstream input(spec.path, std::ios::binary | std::ios::ate);
+        if (!input) {
+            GGML_ABORT("Cannot open GDN 910 kernel: %s", spec.path.c_str());
+        }
+        const std::streamoff size = input.tellg();
+        if (size <= 0 || size > MAX_ELF_BYTES) {
+            GGML_ABORT("Invalid GDN 910 ELF size: %lld", static_cast<long long>(size));
+        }
+        image.resize(static_cast<size_t>(size));
+        input.seekg(0);
+        if (!input.read(image.data(), static_cast<std::streamsize>(image.size()))) {
+            GGML_ABORT("Cannot read complete GDN 910 kernel: %s", spec.path.c_str());
+        }
+        rtDevBinary_t binary{RT_DEV_BINARY_MAGIC_ELF, 0, image.data(), image.size()};
+        ACL_CHECK(rtDevBinaryRegister(&binary, &handle));
+        ACL_CHECK(rtFunctionRegister(handle, spec.stub.c_str(), spec.entry.c_str(), spec.entry.c_str(), 0));
+    }
+
+    gdn_binary(const gdn_binary &) = delete;
+    gdn_binary & operator=(const gdn_binary &) = delete;
+};
+
+gdn_binary & kernel(gdn_mode mode) {
+    // C++ static initialization is thread-safe. Do not unregister after ACL teardown.
+    switch (mode) {
+        case gdn_mode::packed32: {
+            static gdn_binary * const instance = new gdn_binary(mode);
+            return *instance;
+        }
+        case gdn_mode::packed48: {
+            static gdn_binary * const instance = new gdn_binary(mode);
+            return *instance;
+        }
+        case gdn_mode::native48_q16: {
+            static gdn_binary * const instance = new gdn_binary(mode);
+            return *instance;
+        }
+        case gdn_mode::native48_q48: {
+            static gdn_binary * const instance = new gdn_binary(mode);
+            return *instance;
+        }
+        case gdn_mode::unavailable:
+            GGML_ABORT("No compatible GDN 910 kernel");
+    }
+    GGML_ABORT("Invalid GDN 910 kernel mode");
+}
+
+void copy_device(aclrtStream stream, void * destination, const void * source, size_t bytes) {
+    ACL_CHECK(aclrtMemcpyAsync(destination, bytes, source, bytes, ACL_MEMCPY_DEVICE_TO_DEVICE, stream));
+}
+
+void * pack_heads(aclrtStream stream, const ggml_tensor * source, char * packed, int64_t heads) {
+    if (source->ne[1] == heads && source->nb[1] == ROW_BYTES) {
+        return source->data;
+    }
+    // GGML repeats q/k heads cyclically, not with repeat-interleave.
+    for (int64_t head = 0; head < heads; ++head) {
+        const size_t source_offset = static_cast<size_t>(head % source->ne[1]) * source->nb[1];
+        copy_device(stream, packed + head * ROW_BYTES,
+                    static_cast<const char *>(source->data) + source_offset, ROW_BYTES);
+    }
+    return packed;
+}
+
+void launch(gdn_binary & binary, std::array<void *, 8> & arguments,
+            int64_t heads, int device, aclrtStream stream) {
+    const uint32_t block_dim = heads == 48 ? 24 : 32;
+    ACL_CHECK(rtKernelLaunch(binary.spec.stub.c_str(), block_dim,
+                            arguments.data(), sizeof(arguments), nullptr, stream));
+    if (!binary.logged.test_and_set(std::memory_order_relaxed)) {
+        GGML_LOG_INFO("ggml_cann_gdn_910: custom GDN launch queued mode=%s heads=%lld device=%d blocks=%u\n",
+                      binary.spec.entry.c_str(), static_cast<long long>(heads), device, block_dim);
+    }
+}
+}  // namespace
+
+bool ggml_cann_supports_gdn_910(const ggml_tensor * op) {
+    if (op == nullptr || op->op != GGML_OP_GATED_DELTA_NET ||
+        op->type != GGML_TYPE_F32 || !ggml_is_contiguous(op) || ggml_get_op_params_i32(op, 0) != 1) {
+        return false;
+    }
+    for (int index = 0; index < 6; ++index) {
+        if (op->src[index] == nullptr || op->src[index]->type != GGML_TYPE_F32) {
+            return false;
+        }
+    }
+    const ggml_tensor * q = op->src[0];
+    const ggml_tensor * k = op->src[1];
+    const ggml_tensor * v = op->src[2];
+    const ggml_tensor * g = op->src[3];
+    const ggml_tensor * b = op->src[4];
+    const ggml_tensor * s = op->src[5];
+    const int64_t heads = v->ne[1];
+    if (heads != 32 && heads != 48) {
+        return false;
+    }
+    for (const ggml_tensor * source : {q, k}) {
+        if (source->ne[0] != WIDTH || source->ne[1] <= 0 || heads % source->ne[1] != 0 ||
+            source->ne[2] != 1 || source->ne[3] != 1 || !ggml_is_contiguous_rows(source)) {
+            return false;
+        }
+    }
+    return shape(v, WIDTH, heads, 1, 1) && ggml_is_contiguous_rows(v) &&
+           shape(g, 1, heads, 1, 1) && ggml_is_contiguous(g) &&
+           shape(b, 1, heads, 1, 1) && ggml_is_contiguous(b) &&
+           shape(s, WIDTH, WIDTH, heads, 1) && ggml_is_contiguous(s) &&
+           shape(op, WIDTH * heads, 1 + WIDTH, 1, 1) &&
+           ggml_nbytes(op) == static_cast<size_t>(heads) * ROW_BYTES * (1 + WIDTH) &&
+           select_mode(op) != gdn_mode::unavailable;
+}
+
+void ggml_cann_gdn_910(ggml_backend_cann_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_cann_supports_gdn_910(dst));
+    ggml_cann_set_device(ctx.device);
+    const char * soc = aclrtGetSocName();
+    if (soc == nullptr || std::strcmp(soc, "Ascend910B") != 0) {
+        GGML_ABORT("GDN 910 experimental ELF is restricted to legacy Ascend910B");
+    }
+#ifdef USE_ACL_GRAPH
+    if (ctx.acl_graph_mode) {
+        GGML_ABORT("GDN 910 experimental path requires GGML_CANN_ACL_GRAPH=off");
+    }
+#endif
+    const int64_t heads = dst->src[2]->ne[1];
+    const size_t vector_bytes = static_cast<size_t>(heads) * ROW_BYTES;
+    const gdn_mode mode = select_mode(dst);
+    gdn_binary & binary = kernel(mode);
+    aclrtStream stream = ctx.stream();
+
+    if (is_native(mode)) {
+        // The native kernel performs cyclic head mapping and reads compact gates.
+        // All arguments are original device pointers: no staging or D2D copies.
+        std::array<void *, 8> arguments{
+            dst->src[5]->data, dst->src[0]->data, dst->src[1]->data, dst->src[2]->data,
+            dst->src[3]->data, dst->src[4]->data,
+            static_cast<char *>(dst->data) + vector_bytes, dst->data,
+        };
+        launch(binary, arguments, heads, ctx.device, stream);
+        return;
+    }
+
+    const size_t gate_bytes = static_cast<size_t>(heads) * 8 * sizeof(float);
+    ggml_cann_pool_alloc staging(ctx.pool(), 3 * vector_bytes + 2 * gate_bytes);
+    char * base = static_cast<char *>(staging.get());
+    void * q = pack_heads(stream, dst->src[0], base, heads);
+    void * k = pack_heads(stream, dst->src[1], base + vector_bytes, heads);
+    void * v = pack_heads(stream, dst->src[2], base + 2 * vector_bytes, heads);
+    char * gate = base + 3 * vector_bytes;
+    char * beta = gate + gate_bytes;
+    ACL_CHECK(aclrtMemsetAsync(gate, 2 * gate_bytes, 0, 2 * gate_bytes, stream));
+    for (int64_t head = 0; head < heads; ++head) {
+        copy_device(stream, gate + head * 8 * sizeof(float),
+                    static_cast<const char *>(dst->src[3]->data) + head * dst->src[3]->nb[1], sizeof(float));
+        copy_device(stream, beta + head * 8 * sizeof(float),
+                    static_cast<const char *>(dst->src[4]->data) + head * dst->src[4]->nb[1], sizeof(float));
+    }
+    // GGML output: [attention output | updated transposed state].
+    std::array<void *, 8> arguments{
+        dst->src[5]->data, q, k, v, gate, beta,
+        static_cast<char *>(dst->data) + vector_bytes, dst->data,
+    };
+    launch(binary, arguments, heads, ctx.device, stream);
+}
